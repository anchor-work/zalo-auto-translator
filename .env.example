# Firebase web app configuration. These identifiers are public client settings,
# not server credentials. Keep service-account keys out of the extension.
WXT_PUBLIC_FIREBASE_API_KEY=
WXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
WXT_PUBLIC_FIREBASE_PROJECT_ID=
WXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client of type "Chrome Extension", bound to the published
# extension ID.
WXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Public key from the Chrome Web Store developer dashboard. It keeps the
# unpacked development build on the same extension ID as the store item.
WXT_PUBLIC_EXTENSION_KEY=
